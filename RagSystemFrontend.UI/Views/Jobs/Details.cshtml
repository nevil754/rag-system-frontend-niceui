@model IngestionJobDto
@{
    ViewData["Title"] = "Dettaglio job";
}

<div class="mb-4">
    <h1 class="kh-detail-title">Dettaglio job</h1>
</div>

<div class="card kh-detail-card mb-4">
    <div class="card-body p-0">
        <dl class="kh-detail-list">



            <div class="kh-detail-row">
                <dt class="col-sm-3">Id job</dt>
                <dd class="col-sm-9"><code>@Model.Id</code></dd>
            </div>

            <div class="kh-detail-row">
                <dt class="col-sm-3">Documento</dt>
                <dd class="col-sm-9"><code>@Model.DocumentId</code></dd>
            </div>

            <div class="kh-detail-row">
                <dt class="col-sm-3">Stato</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.Status switch
                          {
                              "done" => "text-bg-success",
                              "failed" => "text-bg-danger",
                              "cancelled" => "text-bg-secondary",
                              "running" => "text-bg-info",
                              _ => "text-bg-warning",
                          })">@Model.Status</span>
                </dd>
            </div>

            <div class="kh-detail-row">
                <dt class="col-sm-3">Task Celery</dt>
                <dd class="col-sm-9"><code>@(Model.CeleryTaskId ?? "-")</code></dd>
            </div>

            <div class="kh-detail-row">
                <dt class="col-sm-3">Tentativi</dt>
                <dd class="col-sm-9">@Model.RetryCount</dd>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMsg))
            {
                <div class="kh-detail-row kh-error-row">
                    <dt class="col-sm-3">Errore</dt>
                    <dd class="col-sm-9 text-danger">@Model.ErrorMsg</dd>
                </div>
            }

            <div class="kh-detail-row">
                <dt class="col-sm-3">Creato il</dt>
                <dd class="col-sm-9">@Model.CreatedAt.LocalDateTime.ToString("g")</dd>
            </div>

            <div class="kh-detail-row">

                <dt class="col-sm-3">Avviato il</dt>
                <dd class="col-sm-9">@(Model.StartedAt?.LocalDateTime.ToString("g") ?? "-")</dd>
            </div>

            <div class="kh-detail-row">
                <dt class="col-sm-3">Completato il</dt>
                <dd class="col-sm-9">@(Model.FinishedAt?.LocalDateTime.ToString("g") ?? "-")</dd>
            </div>
        </dl>
    </div>
</div>

<a class="kh-btn-back" asp-controller="Jobs" asp-action="Index">Torna alla lista</a>
