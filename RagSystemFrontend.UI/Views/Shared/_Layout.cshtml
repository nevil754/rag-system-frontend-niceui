<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KnowledgeHub</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RagSystemFrontend.UI.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="@(User.IsTenantAuthenticated() ? "kh-app" : "kh-login-layout")">
        @if (User.IsTenantAuthenticated())
        {
            <aside class="kh-sidebar">
                <div class="container-fluid">
                    <div class="d-flex align-items-center justify-content-between">

                        <!--
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        -->
                        <a class="kh-logo d-flex align-items-center" asp-controller="Home" asp-action="Index">
                            <span class="kh-logo-mark"></span>
                            <span class="kh-logo-text">Knowledge<span>Hub</span></span>
                        </a>
                    </div>

                    <ul class="kh-menu">
                        @if (User.IsTenantAuthenticated())
                        {
                            <a class="kh-menu-item" asp-controller="Chat" asp-action="Index">
                                <span class="kh-menu-icon">
                                    <img src="~/img/icona_chat.png" />
                                </span><span class="nav-link">Chat</span>
                            </a>
                            <a class="kh-menu-item" asp-controller="Documents" asp-action="Index">
                                <span class="kh-menu-icon">
                                    <img src="~/img/icona_documento.png" />
                                </span><span class="nav-link">Documenti</span>
                            </a>
                            <a class="kh-menu-item" asp-controller="Collections" asp-action="Index">
                                <span class="kh-menu-icon">
                                    <img src="~/img/icona_documenti.png" />
                                </span><span class="nav-link">Collezioni</span>
                            </a>
                            <a class="kh-menu-item" asp-controller="Jobs" asp-action="Index">
                                <span class="kh-menu-icon">
                                    <img src="~/img/icona_valigia.png" />
                                </span><span class="nav-link">Job</span>
                            </a>
                            @if (User.IsTenantAdmin())
                            {
                                <a class="kh-menu-item" asp-controller="Users" asp-action="Index">
                                    <span class="kh-menu-icon">
                                        <img src="~/img/icona_utenti.png" />
                                    </span><span class="nav-link">Utenti</span>
                                </a>
                            }
                            @if (User.IsPlatformAuthenticated())
                            {
                                <a class="kh-menu-item" asp-controller="Spaces" asp-action="Index"><span class="nav-link">Cambia Ufficio (Space)</span></a>
                            }
                        }
                        else if (User.IsPlatformAuthenticated())
                        {
                            <a class="kh-menu-item" asp-controller="Spaces" asp-action="Index"><span class="nav-link">I miei Space (Uffici)</span></a>
                        }
                    </ul>
                    <ul class="navbar-nav d-flex flex-column kh-sidebar-footer">
                        @if (User.IsTenantAuthenticated() || User.IsPlatformAuthenticated())
                        {
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex">
                                    <button type="submit" class="kh-exit-btn">Esci</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </aside>
        }
        @if (User.IsTenantAuthenticated())
        {
            <header class="kh-header">
                <div class="kh-header-pages">
                    @if (ViewData["Title"]?.ToString() != "Home")
                    {
                        <div class="kh-header-title">
                            <a class="kh-back-link align-items-center" asp-controller="Home" asp-action="Index">
                                <div class="kh-header-title">Home</div>
                            </a>
                        </div>
                        <div class="kh-header-title kh-back-link">→</div>
                    }
                    @if (ViewData["Title"]?.ToString() == "Job di ingestione")
                    {
                        <div class="kh-header-title">Job</div>
                    }
                    else
                    {
                        <div class="kh-header-title">@ViewData["Title"]</div>
                    }
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="kh-user-menu" tabindex="0">
                        <div class="kh-avatar">@User.Email()?.ToString().Substring(0, 1).ToUpper()</div>
                        <div class="kh-user-copy">
                            <span class="kh-user-name">@User.Email()</span>
                            <span class="kh-user-role">@(User.IsTenantAdmin() ? "Amministratore" : "Utente")</span>
                        </div>
                        <div class="kh-exit-div">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex">
                                <button type="submit" class="kh-exit-btn">Esci</button>
                            </form>
                        </div>
                    </div>
                }

            </header>
        }
        <main role="main" class="@(User.IsTenantAuthenticated() ? "kh-main" : "")">
            <div>
                @if (TempData["Error"] is string errorMessage)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @errorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Chiudi"></button>
                    </div>
                }
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
                        @successMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Chiudi"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </main>

        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - KnowledgeHub - Powered by Compet-e Srl
            </div>
        </footer>
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script>
                    const successAlert = document.getElementById('successAlert');
                    if (successAlert) {
                        setTimeout(() => bootstrap.Alert.getOrCreateInstance(successAlert).close(), 4000);
                    }
        </script>
        @await RenderSectionAsync("Scripts", required: false)
    </div>
</body>
</html>
