@model AccountLoginViewModel
@{
    ViewData["Title"] = "Accedi";
    var platformHasErrors = ViewData.ModelState.Keys.Any(k => k.StartsWith("Platform.", StringComparison.Ordinal));
    var tenantActive = !platformHasErrors;
}

<div class="justify-content-center kh-login-page">
    <div class="col-md-7 kh-login-card">
        <div class="kh-logo" aria-label="KnowledgeHub">
            <span class="kh-logo-mark" aria-hidden="true"></span>
            <span class="kh-logo-text">Knowledge<span>Hub</span></span>
        </div>

        @if (Model.Expired)
        {
            <div class="kh-alert kh-alert-warning" role="alert">
                <svg xmlns="http://w3.org" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="kh-alert-icon"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span>La sessione è scaduta. Effettua nuovamente l'accesso.</span>
            </div>
        }
        @if (!ViewData.ModelState.IsValid)
        {
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div class="kh-alert kh-alert-danger">
                    <svg xmlns="http://w3.org" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="kh-alert-icon"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <span>@error.ErrorMessage</span>
                </div>

            }
        }

        <ul class="nav nav-tabs" id="loginTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(tenantActive ? "active" : "")" id="tenant-tab" data-bs-toggle="tab" data-bs-target="#tenant-pane" type="button" role="tab">
                    Accesso al tuo ufficio
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(tenantActive ? "" : "active")" id="platform-tab" data-bs-toggle="tab" data-bs-target="#platform-pane" type="button" role="tab">
                    Accesso SuperAdmin (tutti gli uffici)
                </button>
            </li>
        </ul>
        <div class="tab-content kh-login-inputs">
            <div class="tab-pane fade @(tenantActive ? "show active" : "")" id="tenant-pane" role="tabpanel">
                <p class="kh-description-text">
                    Accesso diretto a un singolo ufficio: devi già conoscere lo <strong>slug dell'ufficio</strong>
                    <span class="kh-badge-slug">filiale-torino</span> a cui appartieni.
                </p>
                <form asp-controller="Account" asp-action="LoginTenant" method="post">
                    <div class="kh-form-group">
                        <label asp-for="Tenant.Email" class="kh-label"></label>
                        <div class="mb-3 kh-input-wrap">
                            <span class="kh-input-icon">
                                <img src="~/img/icona_email.png" alt="Email Icon" />
                            </span>
                            <input asp-for="Tenant.Email" class="kh-input" autocomplete="username" placeholder="Inserisci la tua email" />
                            <span asp-validation-for="Tenant.Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="kh-form-group">
                        <label asp-for="Tenant.Password" class="kh-label"></label>
                        <div class="mb-3 kh-input-wrap">
                            <span class="kh-input-icon">
                                <img src="~/img/icona_pwd.png" alt="Password Icon" />
                            </span>
                            <input asp-for="Tenant.Password" class="kh-input" autocomplete="current-password" placeholder="Inserisci la tua password" />
                            <span asp-validation-for="Tenant.Password" class="text-danger"></span>
                        </div>
                    </div>


                    <div class="kh-form-group">
                        <label asp-for="Tenant.TenantSlug" class="kh-label"></label>
                        <div class="mb-3 kh-input-wrap">
                            <span class="kh-input-icon">
                                <img src="~/img/icona_ufficio.png" alt="Ufficio Icon" />
                            </span>
                            <input asp-for="Tenant.TenantSlug" class="kh-input" placeholder="es. filiale-torino" />
                            <span asp-validation-for="Tenant.TenantSlug" class="text-danger"></span>
                        </div>

                    </div>
                    <button type="submit" class="kh-primary-btn">Accedi</button>
                </form>
            </div>
            <div class="tab-pane fade @(tenantActive ? "" : "show active")" id="platform-pane" role="tabpanel">
                <p class="kh-description-text">
                    Accesso SuperAdmin: gestione di tutti gli uffici aziendali.
                </p>
                <form asp-controller="Account" asp-action="LoginPlatform" method="post">
                    <div class="kh-form-group">
                        <label asp-for="Platform.Email" class="form-label"></label>
                        <div class="mb-3 kh-input-wrap">
                            <span class="kh-input-icon">
                                <img src="~/img/icona_email.png" alt="Email Icon" />
                            </span>

                            <input asp-for="Platform.Email" class="kh-input" autocomplete="username" placeholder="Inserisci la tua email" />
                        </div>
                        <span asp-validation-for="Platform.Email" class="text-danger"></span>
                    </div>

                    <div class="kh-form-group">
                        <label asp-for="Platform.Password" class="form-label"></label>
                        <div class="mb-3 kh-input-wrap">
                            <span class="kh-input-icon">
                                <img src="~/img/icona_pwd.png" alt="Password Icon" />
                            </span>


                            <input asp-for="Platform.Password" class="kh-input" autocomplete="current-password" placeholder="Inserisci la tua password" />
                        </div>
                        <span asp-validation-for="Platform.Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="kh-primary-btn">Accedi</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
