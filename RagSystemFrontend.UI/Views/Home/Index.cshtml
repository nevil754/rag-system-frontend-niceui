@{
    ViewData["Title"] = "Home";
}

@if (User.IsTenantAuthenticated())
{
    <div class="kh-title-container">
        <h1 class="kh-hero-title">Bentornato@(string.IsNullOrEmpty(User.Email()) ? "" : Html.Raw($", <span>{User.Email()}</span>"))</h1>
        <h5 class="kh-hero-subtitle">Accedi rapidamente alle principali funzionalità e gestisci le tue risorse in modo semplice ed efficace.</h5>
        <p class="kh-hero-subtitle">
            Spazio attivo: <span class="kh-badge-slug">@User.TenantSlug()</span>
            (ruolo <strong>@User.TenantRole()</strong>)
        </p>
    </div>

    <!--CARDS-->
    <div class="kh-quick-grid">
        <a class="kh-quick-card" asp-controller="Chat" asp-action="Index">
            <div class="kh-card-icon">
                <img src="~/img/icona_chat.png" />
            </div>
            <h5 class="kh-card-title">Chat RAG</h5>
            <p class="kh-card-text">Fai domande in linguaggio naturale sui documenti caricati.</p>
            <span class="kh-card-action">→</span>
        </a>

        <a class="kh-quick-card" asp-controller="Documents" asp-action="Index">
            <div class="kh-card-icon">
                <img src="~/img/icona_documento.png" />
            </div>
            <h5 class="kh-card-title">Gestisci documenti</h5>
            <p class="kh-card-text">Carica nuovi documenti e monitora lo stato di ingestione.</p>
            <span class="kh-card-action">→</span>
        </a>

        <a class="kh-quick-card" asp-controller="Collections" asp-action="Index">
            <div class="kh-card-icon">
                <img src="~/img/icona_documenti.png" />
            </div>
            <h5 class="kh-card-title">Collezioni</h5>
            <p class="kh-card-text">Raggruppa i documenti in collezioni logiche.</p>
            <span class="kh-card-action">→</span>
        </a>

        <a class="kh-quick-card" asp-controller="Jobs" asp-action="Index">
            <div class="kh-card-icon">
                <img src="~/img/icona_valigia.png" />
            </div>
            <h5 class="kh-card-title">Job di ingestione</h5>
            <p class="kh-card-text">Controlla l'avanzamento dell'elaborazione dei documenti.</p>
            <span class="kh-card-action">→</span>
        </a>

        @if (User.IsTenantAdmin())
        {
            <a class="kh-quick-card" asp-controller="Users" asp-action="Index">
                <div class="kh-card-icon">
                    <img src="~/img/icona_utenti.png" />
                </div>
                <h5 class="kh-card-title">Utenti</h5>
                <p class="kh-card-text">Gestisci gli utenti di questo Space (solo admin).</p>
                <span class="kh-card-action">→</span>
            </a>
        }
    </div>
}
else if (User.IsPlatformAuthenticated())
{
    <div class="mb-4">
        <h1 class="display-6">Bentornato@(string.IsNullOrEmpty(User.Email()) ? "" : $", {User.Email()}")</h1>
        <p class="lead">Sei autenticato a livello platform. Seleziona uno Space per iniziare a lavorare.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Spaces" asp-action="Index">Vai ai tuoi Space</a>
}

