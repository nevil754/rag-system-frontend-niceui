@model ChatIndexViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Chat";
    var tokens = Antiforgery.GetAndStoreTokens(Context);
}

<meta name="csrf-token" content="@tokens.RequestToken" />


<div class="kh-chat-intro">
    <div class="kh-chat-brand"><span class="kh-logo-mark"></span><span class="kh-chat-spark">✦</span></div>

    <h1>Benvenuto nella chat di <span>KnowledgeHub</span></h1>
    <p>Fai domande sui tuoi documenti e sulla tua conoscenza.<br>Ti risponderemo con informazioni affidabili e pertinenti.</p>
</div>


<div class="d-flex flex-wrap gap-4 align-items-center mb-3 w-100">

    <!-- BLOCCO COLLETION -->
    <div class="kh-chat-intro kh-select-group mb-0">
        <label for="collectionSelect" class="kh-select-label">Collezione</label>
        <div class="kh-select-wrapper">
            <select id="collectionSelect" class="kh-collection-select">
                <option value="">Tutti i documenti</option>
                @foreach (var collection in Model.Collections)
                {
                    <option value="@collection.Id">@collection.Name</option>
                }
            </select>
            <span class="kh-select-arrow">⌄</span>
        </div>
    </div>
    <!-- BLOCCO SWITCH -->
    <div class="form-check form-switch kh-switch mb-0">
        <input class="form-check-input" type="checkbox" id="streamingToggle">
        <label class="kh-select-label" for="streamingToggle">Streaming (senza feedback)</label>
    </div>

    <!-- PULSANTE -->
    <button type="button" id="newConversationBtn" class="kh-new-btn ms-auto">Nuova conversazione</button>

</div>

<div id="chatMessages" class="kh-chat-messages"></div>

<form id="chatForm" class="kh-chat-form">
    <div class="kh-input-container">
        <div class="kh-textarea-grow">
            <textarea id="questionInput" class="kh-chat-textarea" rows="1" placeholder="Scrivi una domanda sui tuoi documenti..." required maxlength="10000" oninput="this.parentNode.dataset.replicatedValue = this.value"></textarea>
        </div>
    </div>
    <button type="submit" class="kh-chat-send-btn" id="sendBtn">Invia</button>
</form>

@section Scripts {
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
